<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>LightGuard Uyandırma Olayı</Description>
    <URI>\LightGuard_WakeUp</URI>
  </RegistrationInfo>
  <Triggers>
    <EventTrigger>
      <Enabled>true</Enabled>
      <Subscription>
        <QueryList>
          <Query Id="0" Path="System">
            <Select Path="System">*[System[(EventID=1)]]</Select>
          </Query>
        </QueryList>
      </Subscription>
    </EventTrigger>
  </Triggers>
  <Actions>
    <Exec>
      <Command>python.exe</Command>
      <Arguments>D:\Repo\Python\LightGuard\main.py</Arguments>
    </Exec>
  </Actions>
</Task>